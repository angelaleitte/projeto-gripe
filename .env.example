# Copie este arquivo para .env e preencha com valores reais.
# O .env NUNCA deve ser commitado (já está no .gitignore).
# No Coolify, essas variáveis são configuradas na aba "Environment Variables"
# do recurso — não é necessário subir um .env pro repositório.

MYSQL_ROOT_PASSWORD=troque-por-uma-senha-forte
MYSQL_PASSWORD=troque-por-outra-senha-forte

# Preencher a partir da Semana 4 do plano (Agents SDK / LLM)
# OPENAI_API_KEY=
